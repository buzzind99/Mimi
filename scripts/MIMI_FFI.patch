+
+// ===========================================================================
+// Mimi local patch — recorded in MIMI_FFI.patch (canonical tracked copy:
+// scripts/MIMI_FFI.patch, applied by scripts/build_dictionary.sh). Keep this
+// section when pulling newer upstream commits.
+// ===========================================================================
+
+/// Build a JMdict SQLite database from a local JMdict_e.gz file.
+///
+/// Returns 0 on success, 1 on failure.
+///
+/// # Safety
+/// - `db_path` and `gz_path` must be valid, non-null, null-terminated UTF-8
+///   strings.
+#[no_mangle]
+pub unsafe extern "C" fn tentoku_build_db(
+    db_path: *const c_char,
+    gz_path: *const c_char,
+) -> i32 {
+    if db_path.is_null() || gz_path.is_null() {
+        return 1;
+    }
+    let db_str = match CStr::from_ptr(db_path).to_str() {
+        Ok(s) => s,
+        Err(_) => return 1,
+    };
+    let gz_str = match CStr::from_ptr(gz_path).to_str() {
+        Ok(s) => s,
+        Err(_) => return 1,
+    };
+    let gz_bytes = match std::fs::read(Path::new(gz_str)) {
+        Ok(bytes) => bytes,
+        Err(_) => return 1,
+    };
+    match crate::build_database::build_database(db_str, Some(gz_bytes)) {
+        Ok(()) => 0,
+        Err(_) => 1,
+    }
+}
diff --git a/tests/ffi_build.rs b/tests/ffi_build.rs
new file mode 100644
index 0000000..e3a97bd
--- /dev/null
+++ b/tests/ffi_build.rs
@@ -0,0 +1,106 @@
+//! Integration test for the Mimi-added `tentoku_build_db` FFI export
+//! (see MIMI_FFI.patch): builds a SQLite database from a tiny in-memory
+//! JMdict_e.gz fixture and exercises it through the FFI handle API.
+
+use std::ffi::{CStr, CString};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+use flate2::write::GzEncoder;
+use flate2::Compression;
+use tempfile::TempDir;
+
+use tentoku::ffi::{
+    tentoku_build_db, tentoku_free, tentoku_free_string, tentoku_open, tentoku_tokenize_json,
+};
+
+const MINI_JMDICT: &str = r#"<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE JMdict [
+<!ENTITY n "noun (common) (futsuumeishi)">
+<!ENTITY v1 "Ichidan verb">
+]>
+<JMdict>
+<entry>
+<ent_seq>1549240</ent_seq>
+<k_ele><keb>学生</keb><ke_pri>ichi1</ke_pri></k_ele>
+<r_ele><reb>がくせい</reb><re_pri>ichi1</re_pri></r_ele>
+<sense><pos>&n;</pos><gloss>student</gloss></sense>
+</entry>
+<entry>
+<ent_seq>1418230</ent_seq>
+<k_ele><keb>食べる</keb><ke_pri>ichi1</ke_pri></k_ele>
+<r_ele><reb>たべる</reb><re_pri>ichi1</re_pri></r_ele>
+<sense><pos>&v1;</pos><gloss>to eat</gloss></sense>
+</entry>
+</JMdict>"#;
+
+fn write_gz_fixture(dir: &TempDir, xml: &str) -> PathBuf {
+    let gz_path = dir.path().join("JMdict_e.gz");
+    let mut encoder = GzEncoder::new(
+        std::fs::File::create(&gz_path).unwrap(),
+        Compression::default(),
+    );
+    encoder.write_all(xml.as_bytes()).unwrap();
+    encoder.finish().unwrap();
+    gz_path
+}
+
+fn cstring(path: &Path) -> CString {
+    CString::new(path.to_str().unwrap()).unwrap()
+}
+
+#[test]
+fn build_db_from_gz_fixture_then_open_and_tokenize() {
+    let dir = TempDir::new().unwrap();
+    let gz_path = write_gz_fixture(&dir, MINI_JMDICT);
+    let db_path = dir.path().join("jmdict.db");
+
+    let rc = unsafe { tentoku_build_db(cstring(&db_path).as_ptr(), cstring(&gz_path).as_ptr()) };
+    assert_eq!(rc, 0, "tentoku_build_db should succeed on a valid gz fixture");
+    assert!(db_path.exists(), "tentoku_build_db should create the DB file");
+
+    // Open the freshly built DB through the FFI and tokenize a sentence that
+    // hits one of the fixture entries.
+    let handle = unsafe { tentoku_open(cstring(&db_path).as_ptr()) };
+    assert!(!handle.is_null(), "tentoku_open should accept the built DB");
+
+    let text = CString::new("私は学生です").unwrap();
+    let json_ptr = unsafe { tentoku_tokenize_json(handle, text.as_ptr(), 1) };
+    assert!(!json_ptr.is_null(), "tokenize should return JSON");
+    let json = unsafe { CStr::from_ptr(json_ptr) }
+        .to_string_lossy()
+        .into_owned();
+    unsafe { tentoku_free_string(json_ptr) };
+
+    assert!(json.contains("学生"), "surface missing from token JSON: {json}");
+    assert!(
+        json.contains("がくせい"),
+        "dictionary kana reading missing from token JSON: {json}"
+    );
+
+    unsafe { tentoku_free(handle) };
+}
+
+#[test]
+fn build_db_rejects_bad_input() {
+    let dir = TempDir::new().unwrap();
+
+    // Not gzip.
+    let junk = dir.path().join("junk.gz");
+    std::fs::write(&junk, b"definitely not gzip").unwrap();
+
+    // Missing gz file.
+    let missing = dir.path().join("missing.gz");
+
+    for gz in [&junk, &missing] {
+        let db_path = dir.path().join(format!("{}.db", gz.file_name().unwrap().to_str().unwrap()));
+        let rc = unsafe { tentoku_build_db(cstring(&db_path).as_ptr(), cstring(gz).as_ptr()) };
+        assert_eq!(rc, 1, "tentoku_build_db should fail for {}", gz.display());
+    }
+
+    // Null pointers must fail, not crash.
+    let rc = unsafe { tentoku_build_db(std::ptr::null(), cstring(&junk).as_ptr()) };
+    assert_eq!(rc, 1);
+    let rc = unsafe { tentoku_build_db(cstring(&junk).as_ptr(), std::ptr::null()) };
+    assert_eq!(rc, 1);
+}
